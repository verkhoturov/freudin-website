# Скопируй в .env и заполни: его читают и Next.js, и Supabase CLI. Все переменные серверные:
# без префикса NEXT_PUBLIC_ в браузер они не попадают.
# Значения бери в Supabase → Project Settings → API Keys.

# Нужны с шага 7 плана (docs/PLAN.md)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Вход через Google со своим адресом возврата (шаг 8.1 плана): на экране Google виден сайт,
# а не <ref>.supabase.co. Те же Client ID и Client secret, что в Supabase → Authentication →
# Providers → Google.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Только для Supabase CLI (миграции и генерация типов), приложению не нужны.
# Токен: Supabase → Account → Access Tokens. Пароль базы задаётся при создании проекта.
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=...
